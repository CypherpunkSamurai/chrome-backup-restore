{
  "manifest_version": 3,
  "name": "Chrome Data Manager",
  "version": "1.0.0",
  "description": "Import and export Chrome extensions, bookmarks, history, and cookies.",
  "permissions": [
    "management",
    "bookmarks",
    "history",
    "cookies",
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Chrome Data Manager",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
